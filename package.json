{
  "name": "open-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js --host 127.0.0.1",
    "dev:server": "node --max-http-header-size=65536 server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "livekit-client": "2.22.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
