# Your public domain (point its DNS A/AAAA record to this server first).
OFFICE_DOMAIN=office.example.org
# Shared invite key: people need it to enter. Invite links include it as ?key=...
OFFICE_ACCESS_KEY=change-me-long-random-invite-key
# Admin key: open the office once with ?admin=... to decorate, rename rooms and create channels.
OFFICE_ADMIN_KEY=change-me-long-random-admin-key
# Who may decorate: "admins" (default when an admin key is set) or "everyone".
EDIT_POLICY=admins
# TURN relay for calls between different networks (used by the coturn service).
TURN_USERNAME=office
TURN_PASSWORD=change-me-turn-password
# The browsers receive these STUN/TURN servers at runtime (keep in sync with the values above).
ICE_SERVERS=[{"urls":"stun:office.example.org:3478"},{"urls":"turn:office.example.org:3478","username":"office","credential":"change-me-turn-password"}]
# Personal accounts: off, optional or required.
ACCOUNTS=optional
# Extra browser origins allowed to connect (the office's own domain is always allowed).
ALLOWED_ORIGINS=
